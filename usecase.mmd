admin --> UC_Auth
admin --> UC_ManageContent
admin --> UC_ManageUsers
admin --> UC_ViewLogs
admin --> UC_ConfigAI

ai ..> UC_SearchDocs : truy vấn nguồn
ai --> UC_ChatAI
