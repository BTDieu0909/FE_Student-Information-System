usecase UC_UploadDoc as "Tải lên tài liệu (Staff)"
usecase UC_ProcessDoc as "Xử lý/Index tài liệu"
usecase UC_SearchFaq as "Tìm kiếm FAQ"
usecase UC_ViewFaq as "Xem FAQ"
usecase UC_ChatAI as "Hỏi/Trả lời AI (Chat)"
usecase UC_ViewDept as "Xem phòng ban"
usecase UC_Auth as "Đăng nhập/Đăng xuất"
